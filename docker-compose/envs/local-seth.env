# 本地运行 Indexer，从 Seth RPC 拉取数据
# 使用方式（PowerShell）: Get-Content docker-compose/envs/local-seth.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }; mix phx.server
# 或复制为 .env 后按下方说明执行

# RPC 地址（必填）
ETHEREUM_JSONRPC_HTTP_URL=http://35.197.170.240:23001
ETHEREUM_JSONRPC_VARIANT=geth

# 本地 PostgreSQL：未设置 DATABASE_URL 时使用 database=explorer_dev, hostname=localhost
# 若已部署 Postgres，可设为（请替换用户名/密码/库名）:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/explorer_dev

# 可选
CHAIN_TYPE=default
PORT=4000
DISABLE_MARKET=true
